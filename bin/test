#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

CLEAN=0
for arg in "$@"; do
  case "$arg" in
    -c|--clean) CLEAN=1 ;;
    *) echo "Usage: bin/test [-c|--clean]" >&2; exit 2 ;;
  esac
done

COMPILER_DIR="$(cd ../purust && pwd)"
SPAGO_BIN="$COMPILER_DIR/node_modules/.bin/spago"
if [ ! -x "$SPAGO_BIN" ]; then
  printf 'Missing Spago dependency. Run npm install in %s.\n' "$COMPILER_DIR" >&2
  exit 1
fi
# Prefer the sibling TAST fork; PURS can select another build explicitly.
if [ -n "${PURS:-}" ]; then
  PURS_BIN="$(command -v "$PURS")"
else
  FORK_BUILDS=("$COMPILER_DIR"/../../purescript/.stack-work/dist/*/*/build/purs/purs)
  if [ "${#FORK_BUILDS[@]}" = 1 ] && [ -x "${FORK_BUILDS[0]}" ]; then
    PURS_BIN="${FORK_BUILDS[0]}"
  else
    PURS_BIN="$(command -v purs)"
  fi
fi
export PATH="$(dirname "$PURS_BIN"):$COMPILER_DIR/node_modules/.bin:$PATH"
if [ "$CLEAN" = 1 ]; then
  echo "=== Recompiling purust ==="
  # Run Spago directly with the TAST-enabled compiler first on PATH.
  (cd "$COMPILER_DIR" && "$SPAGO_BIN" build \
    && "$SPAGO_BIN" bundle --module Main --platform node --outfile bin/purust.js --bundle-type app)
fi

# The CLI scenarios run real fixture binaries, so build them first. In a
# normal run Spago/cargo rebuild only what changed; `-c` cleans them fully.
build_fixture() {
  local dir="$1"
  echo "=== Building fixture: $dir ==="
  (
    cd "test-fixtures/$dir"
    if [ "$CLEAN" = 1 ]; then rm -rf output .spago .cache; fi
    "$SPAGO_BIN" build \
      && cargo build --manifest-path output/purust_output/Cargo.toml
  ) || exit 1
}
build_fixture project
build_fixture issue-2-non-identity-generator-monad

# Clean this package only. Always regenerate its TAST and Rust output.
rm -rf output
if [ "$CLEAN" = 1 ]; then
  rm -rf .spago .cache
fi

echo "=== Building TAST and generating Rust with spago ==="
"$SPAGO_BIN" build
node -e 'const fs = require("node:fs"); const m = JSON.parse(fs.readFileSync("output/Test.Main/corefn.json", "utf8")); if (!Array.isArray(m.dataDecls)) { console.error("A TAST-enabled PureScript fork is required; set PURS to its executable."); process.exit(1); }'

echo "=== Compiling Rust FFI and tests ==="
cargo build --manifest-path output/purust_output/Cargo.toml

echo "=== Running the spec-node CLI suite ==="
BINARY="output/purust_output/target/debug/purust_output"
# Absolute fixture paths: the native spawn resolves a relative program path
# against the child cwd, so pass fully resolved binaries.
export PURUST_SPEC_NODE_FIXTURE_PROJECT="$PWD/test-fixtures/project/output/purust_output/target/debug/purust_output"
export PURUST_SPEC_NODE_FIXTURE_ISSUE2="$PWD/test-fixtures/issue-2-non-identity-generator-monad/output/purust_output/target/debug/purust_output"
status=0
node -e 'const { spawnSync } = require("node:child_process"); const result = spawnSync(process.argv[1], [], { stdio: "inherit", cwd: process.argv[2], timeout: 300000 }); if (result.error) console.error(result.error.message); process.exit(result.status ?? 1);' "$BINARY" . > output/actual.stdout 2> output/actual.stderr || status=$?
cat output/actual.stdout
if [ "$status" -ne 0 ] || [ -s output/actual.stderr ]; then
  cat output/actual.stderr >&2
  echo "[FAILED] spec-node tests exited with status $status" >&2
  exit 1
fi
if ! grep -qE '[0-9]+/[0-9]+ tests passed' output/actual.stdout; then
  echo "[FAILED] the spec-node suite did not report a passing summary" >&2
  exit 1
fi
echo "Summary: the spec-node CLI suite passed (project and issue-2 fixtures)."
